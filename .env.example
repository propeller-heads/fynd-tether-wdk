# For README examples and tests. Keep credentials and .env files out of git.

# Supported IDs: 1, 8453, 42161, 56, 137, 130, 4663. Set matching RPC and tokens.
CHAIN_ID=1
# Hosted API: set FYND_API_KEY (FYND_BASE_URL only for your own proxy).
FYND_API_KEY=
FYND_BASE_URL=
# Self-hosted Fynd instead: set its URL and leave FYND_API_KEY empty.
FYND_SELF_HOSTED_URL=
RPC_URL=

# Wallet example seed.
WDK_SEED_PHRASE=

# Ethereum native ETH -> USDT. Amounts are integer token base units.
FROM_TOKEN=0x0000000000000000000000000000000000000000
TO_TOKEN=0xdAC17F958D2ee523a2206206994597C13D831ec7
AMOUNT_IN=1000000000000000
# Required for ACTION=execute: your output floor in base units (USDT has 6 decimals).
MIN_AMOUNT_OUT=
RECIPIENT=

# Execution fee caps: blank omits the cap; 0 enforces zero.
# Network caps require Ethereum, BNB Smart Chain or Polygon, sufficient allowance and a WDK swap estimate.
MAX_NETWORK_FEE_BPS=
MAX_PROTOCOL_FEE_BPS=

ACTION=quote
# Returned swap hash for ACTION=status.
SWAP_ID=

# Tests. pnpm test needs Anvil 1.7.1; set ANVIL_BIN if it is not on PATH.
ANVIL_BIN=
# tests/live-fork.test.js runs only with ETHEREUM_RPC_URL and FYND_API_KEY or FYND_SELF_HOSTED_URL.
# ETHEREUM_RPC_URL must be an archive RPC that serves state at FORK_BLOCK_NUMBER (blank uses the pinned block;
# `latest` forks the head and works with any RPC).
ETHEREUM_RPC_URL=
FORK_BLOCK_NUMBER=
