# For README examples. Keep credentials and .env files out of git.

# Supported IDs: 1, 8453, 42161, 56, 137, 130, 4663. Set matching RPC and tokens.
CHAIN_ID=1
# Hosted API: set FYND_API_KEY (FYND_BASE_URL only for your own proxy).
FYND_API_KEY=
FYND_BASE_URL=
# Self-hosted Fynd instead: set its URL and leave FYND_API_KEY empty.
FYND_SELF_HOSTED_URL=
RPC_URL=

# Wallet example seed.
WDK_SEED_PHRASE=

# Ethereum native ETH -> USDC. Amounts are integer token base units.
FROM_TOKEN=0x0000000000000000000000000000000000000000
TO_TOKEN=0xa0b86991c6218b36c1d19d4a2e9eb0ce3606eb48
AMOUNT_IN=1000000000000000
# Required for ACTION=execute: your output floor in base units (USDC has 6 decimals).
MIN_AMOUNT_OUT=
RECIPIENT=

# Execution fee caps: blank omits the cap; 0 enforces zero.
# Network caps require Ethereum, BNB Smart Chain or Polygon, sufficient allowance and a WDK swap estimate.
MAX_NETWORK_FEE_BPS=
MAX_PROTOCOL_FEE_BPS=

ACTION=quote
# Returned swap hash for ACTION=status.
SWAP_ID=
