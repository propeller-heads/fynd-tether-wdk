# For README examples and tests. Keep credentials and .env files out of git.

# Supported IDs: 1, 8453, 42161, 56, 137, 130, 4663, 5042, 99901. Set matching RPC and tokens.
CHAIN_ID=1
# Hosted API: set FYND_API_KEY (FYND_BASE_URL only for your own proxy).
FYND_API_KEY=
FYND_BASE_URL=
# Self-hosted Fynd instead: set its URL and leave FYND_API_KEY empty.
FYND_SELF_HOSTED_URL=
RPC_URL=

# Wallet example seed.
WDK_SEED_PHRASE=

# Ethereum native ETH -> USDT. Amounts are integer token base units.
FROM_TOKEN=0x0000000000000000000000000000000000000000
TO_TOKEN=0xdAC17F958D2ee523a2206206994597C13D831ec7
AMOUNT_IN=1000000000000000
# Required for ACTION=execute: your output floor in base units (USDT has 6 decimals).
MIN_AMOUNT_OUT=
RECIPIENT=

# Execution fee caps: blank omits the cap; 0 enforces zero.
# Network caps require Ethereum, BNB Smart Chain, Polygon or Arc, sufficient allowance and a WDK swap estimate.
MAX_NETWORK_FEE_BPS=
MAX_PROTOCOL_FEE_BPS=

ACTION=quote
# Returned swap hash for ACTION=status.
SWAP_ID=

# Tests. pnpm test needs Anvil 1.7.1; set ANVIL_BIN if it is not on PATH.
ANVIL_BIN=
# tests/live-fork.test.js forks each chain whose <CHAIN>_RPC_URL is set, with FYND_API_KEY or FYND_SELF_HOSTED_URL
# (self-hosted: set only the RPC of that server's chain). Ethereum forks a pinned block, so ETHEREUM_RPC_URL must be
# an archive RPC that serves ETHEREUM_FORK_BLOCK_NUMBER (blank uses the pinned block; `latest` works with any RPC).
# Other chains fork 10 blocks behind their head unless <CHAIN>_FORK_BLOCK_NUMBER is set. Each RPC must serve state at
# the fork block for the whole run: publicnode's Arbitrum and Unichain endpoints keep only minutes of state, so use
# https://arb1.arbitrum.io/rpc and https://mainnet.unichain.org there.
ETHEREUM_RPC_URL=
ETHEREUM_FORK_BLOCK_NUMBER=
BASE_RPC_URL=
ARBITRUM_RPC_URL=
BSC_RPC_URL=
POLYGON_RPC_URL=
UNICHAIN_RPC_URL=
ROBINHOOD_RPC_URL=
ARC_RPC_URL=
ELYSIUM_RPC_URL=
